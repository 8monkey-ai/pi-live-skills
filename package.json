{
	"name": "@8monkey/pi-live-skills",
	"version": "0.1.0",
	"description": "Pi extension that keeps skills, context files and system prompt files in the model context the same as on disk.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/8monkey-ai/pi-live-skills.git"
	},
	"homepage": "https://github.com/8monkey-ai/pi-live-skills#readme",
	"bugs": "https://github.com/8monkey-ai/pi-live-skills/issues",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"format": "biome format --write",
		"lint": "biome lint",
		"typecheck": "tsc --noEmit",
		"test": "node --test",
		"check": "biome check && tsc --noEmit && node --test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.4",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"pi-package",
		"pi",
		"skills",
		"context",
		"system-prompt"
	]
}
